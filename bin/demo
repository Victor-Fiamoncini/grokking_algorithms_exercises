#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/grokking_algorithms_exercises"

binary_search = GrokkingAlgorithmsExercises::BinarySearch.new([1, 3, 5, 7, 9])
searched_index = binary_search.execute(7)

puts "Binary search: #{searched_index}"

selection_sort = GrokkingAlgorithmsExercises::SelectionSort.new([8, 5, 7, 1, 9, 3])
ordered_items = selection_sort.execute.join(", ")

puts "Selection sort ordered items: #{ordered_items}"

recursive_factorial = GrokkingAlgorithmsExercises::RecursiveFactorial.new
factorial = recursive_factorial.execute(10)

puts "Recursive factorial: #{factorial}"
